<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    
    <!-- Thông tin package -->
    <PackageId>DryFish.ILib</PackageId>
    <Version>2026.3.0</Version>
    <Authors>DryFish</Authors>
    <Company>DryFish</Company>
    <Product>DryFish ILib</Product>
    <Description>Simple C# library for logging, delay, and console utilities</Description>
    <PackageTags>console;logging;utility;dryfish;ilib;dotnet</PackageTags>
    <PackageProjectUrl>https://github.com/dryfish09/ILib</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dryfish09/ILib</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    
    <!-- Tạo XML documentation -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(PackageId).xml</DocumentationFile>
    
    <!-- Tạo symbols cho debugging -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    
    <!-- Source linking cho debugging -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    
    <!-- Output -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageOutputPath>../../nupkg</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- SourceLink cho debugging -->
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.300" PrivateAssets="All"/>
  </ItemGroup>

  <ItemGroup>
    <!-- Đưa README vào package -->
    <None Include="../../README.md" Pack="true" PackagePath="/"/>
  </ItemGroup>
</Project>
